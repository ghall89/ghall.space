---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BlogHeader from '@components/Blog/BlogHeader.astro';
import Tags from '@components/Blog/Tags.astro';
import Layout from '@layouts/Layout.astro';

const headerImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/blog/_headers/*',
	{ eager: true }
);

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;

const { data } = post;

const { Content } = await render(post);

const canonicalUrl = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const headerImg = data.headerImg
	? headerImages[`/src/assets/blog/_headers/${data.headerImg}`]?.default
	: undefined;
---

<Layout title={data.title} type="article" image={headerImg}>
	<article>
		{
			headerImg && (
				<div class="header-img">
					<Image src={headerImg} alt="" />
				</div>
			)
		}
		<BlogHeader title={data.title} date={data.pubDate} />
		<Tags tags={data.tags} />
		<hr />
		<Content />
		<hr />
		<div class="badges">
			<a
				class="share-button"
				href={`https://share.joinmastodon.org/#text=${data.title}%0A%0A${canonicalUrl}`}
				target="_blank"
				rel="noopener">Share on Mastodon</a
			>
			<a
				href="https://notbyai.fyi/"
				target="_blank"
				aria-label="Written by human, not by AI"
			>
				<i class="not-by-ai" aria-hidden="true"></i>
			</a>
		</div>
	</article>
</Layout>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	hr {
		border: var(--border);
		margin: 1rem 0;
	}

	.header-img {
		width: 100%;
		height: 300px;
		border-radius: $radius;
		overflow: hidden;
		margin-bottom: 1rem;
		box-shadow: var(--soft-shadow);

		img: {
			border-radius: 0px !important;
		}
	}

	.badges {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.share-button {
		display: inline-block;
		margin: 1.5rem 0;
		padding: 8px 18px;
		border-radius: 999px;
		color: #ffffff;
		background: var(--button-gradient);
		text-decoration: none;
		font-weight: 700;
		border: 1px solid rgba(0, 0, 0, 0.1);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
		transition: $quick-transition;

		&:hover {
			filter: brightness(1.08);
			text-decoration: none;
		}
	}

	.not-by-ai {
		display: block;
		width: 134px;
		height: 45px;
		background-image: url(../../assets/svg/Written-By-Human-Not-By-AI-Badge-white.svg);
		background-repeat: no-repeat;
		background-position: center;
		margin: 1rem 0;
	}
</style>
