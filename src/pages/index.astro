---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Card from '@components/Card.astro';
import PillList from '@components/PillList.astro';
import Layout from '@layouts/Layout.astro';
import BlueskyIcon from '../assets/svg/bluesky.svg';
import MastodonIcon from '../assets/svg/mastodon.svg';

import { aboutMe } from '@data/about-me';

import avatarPng from '@assets/avatar.png';
import avatarHoverPng from '@assets/avatar-hover.png';
import avatarBlinkPng from '@assets/avatar-blink.png';

const ICON_SIZE = 16;

const posts = await getCollection('blog');

const latestPost = posts.sort(
	(a, b) =>
		new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
)[0];
---

<Layout title="Welcome">
	<div class="container">
		<Image
			src={avatarPng}
			alt="Illustrated portrait of a person with glasses and a beard, wearing a red and black plaid shirt. The background is a solid green color."
			class="portrait"
		/>
		<section>
			<h1>Welcome to my home on the World Wide Web!</h1>
			<p>
				My name is <strong>Graham</strong> (he/him), a full-stack web developer, and
				tech enthusiast living in the United States.
			</p>
			<p>
				When I'm not writing code, I'm usually enjoying one of my other hobbies.
				I enjoy playing video games (mainly RPGs) and board games, solving
				crossword puzzles, and doing the daily Wordle. I'm passionate about
				music, though I am not very musical, and ocassionally enjoy a good
				movie.
			</p>
			<p>
				I'm not super outdoorsy, but when I am outside I prefer to spend my time
				in nature. Even better if there are cute animals around. 🐰
			</p>
			<p>
				I also like writing about stuff, so I built this website to share
				whatever's on my mind about the world of tech, gaming, life, web
				development, and whatever else strikes my fancy.
			</p>
			<p>
				Read my latest blog post, <a href={`blog/${latestPost.id}`}
					>{latestPost.data.title}</a
				>, posted on {new Date(latestPost.data.pubDate).toLocaleDateString()}.
			</p>
			<p>
				If your interested in checking out my web dev projects, check out <a
					href="https://ghall.dev/"
					target="_blank"
					rel="noopener noreferrer">my portfolio</a
				>.
			</p>
			<p>
				If you want to get in touch, I'm on <a
					rel="me noopener noreferrer"
					href="https://mastodon.social/@ghalldev"
					target="_blank"
					><MastodonIcon
						width={ICON_SIZE}
						height={ICON_SIZE}
						aria-hidden="true"
					/>Mastodon</a
				> and <a
					href="https://bsky.app/profile/ghalldev.bsky.social"
					target="_blank"
					rel="noopener noreferrer"
					><BlueskyIcon
						width={ICON_SIZE}
						height={ICON_SIZE}
						aria-hidden="true"
					/>Bluesky</a
				>.
			</p>
		</section>

		<section class="likes-dislikes">
			<Card title="Likes">
				<PillList items={aboutMe.likes} />
			</Card>
			<Card title="Dislikes">
				<PillList items={aboutMe.dislikes} />
			</Card>
		</section>

		<section>
			<h2>About This Website</h2>
			<p>
				It was built with <a href="https://astro.build" target="_blank">Astro</a
				>
				and <a href="https://sass-lang.com" target="_blank">Sass</a>, using the
				<a href="https://deno.com" target="_blank">Deno</a> JavaScript runtime.
			</p>

			<span class="acknowledgment">
				Avatar created with <a
					href="https://www.avatarsinpixels.com/minipix/clothing/Eyes"
					target="_blank">Avatars in Pixels</a
				>.
			</span>
		</section>
	</div>

	<script
		is:inline
		define:vars={{ hoverSrc: avatarHoverPng.src, blinkSrc: avatarBlinkPng.src }}
	>
		const img = document.querySelector('.portrait');
		if (img) {
			const originalSrc = img.src;
			const originalSrcset = img.srcset;
			let isHovered = false;
			let isBlinking = false;

			const prefersReducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches;

			const updateImage = () => {
				if (isHovered) {
					img.src = hoverSrc;
					img.srcset = '';
				} else if (isBlinking) {
					img.src = blinkSrc;
					img.srcset = '';
				} else {
					img.src = originalSrc;
					img.srcset = originalSrcset;
				}
			};

			img.addEventListener('mouseenter', () => {
				isHovered = true;
				updateImage();
			});

			img.addEventListener('mouseleave', () => {
				isHovered = false;
				updateImage();
			});

			if (prefersReducedMotion) {
				return;
			}

			const randomInterval = () => Math.floor(Math.random() * 4000) + 2000;

			const scheduleBlink = () => {
				setTimeout(() => {
					if (isHovered) {
						scheduleBlink();
						return;
					}

					isBlinking = true;
					updateImage();

					setTimeout(() => {
						isBlinking = false;
						updateImage();
						scheduleBlink();
					}, 200);
				}, randomInterval());
			};

			scheduleBlink();
		}
	</script>
</Layout>

<style lang="scss">
	@use '../styles/variables.scss' as *;

	.portrait {
		float: left;
		margin-inline-end: 1rem;
		margin-block-end: 0.5rem;
	}

	.acknowledgment {
		font-style: italic;
	}

	.likes-dislikes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1rem;
		clear: left;
		margin: 2rem;

		@media (max-width: $max-mobile-width) {
			grid-template-columns: 1fr;
		}
	}

	a > svg {
		transform: translateY(0.1rem);
	}
</style>
