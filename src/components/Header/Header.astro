---
import Drawer from './Drawer.astro';
import Nav from './Nav.astro';
---

<header>
	<div class="container">
		<a href="/">ghall.space</a>
		<div>
			<Nav />
			<Drawer />
		</div>
	</div>
</header>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	header {
		position: sticky;
		top: 0;
		z-index: 1;
		background: var(--surface);
		border-bottom: var(--border);
	}

	.container {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 1rem;
		max-width: $max-page-width;
		margin: 0 auto;
		padding: 1rem;
	}

	a {
		font-size: 1.25rem;
		font-weight: bold;
		color: var(--text);
		text-decoration: none;
	}
</style>
