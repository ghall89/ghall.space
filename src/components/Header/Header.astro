---
import Drawer from './Drawer.astro';
import Nav from './Nav.astro';
---

<header>
	<div class="container">
		<a href="/">ghall.space</a>
		<div>
			<Nav />
			<Drawer />
		</div>
	</div>
</header>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	header {
		margin-bottom: 20px;
		height: 80px;
		background: var(--header-gradient);
		width: 100%;
		top: 0;
		position: fixed;
		z-index: 1;
		border-bottom: 1px solid rgba(255, 255, 255, 0.25);
		box-shadow: var(--header-shadow);

		& .container {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			max-width: $max-page-width;
			margin: auto;
			padding: 0 16px;
			height: 100%;

			& div {
				display: flex;
				gap: 20px;
				align-items: center;
			}
		}
	}

	a {
		font-size: 1.7rem;
		color: #ffffff;
		font-weight: bold;
		text-decoration: none;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);

		&:hover {
			opacity: 0.85;
		}
	}
</style>
