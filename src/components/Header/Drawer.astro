---
import BarsIcon from '../../assets/svg/bars.svg';
import CloseIcon from '../../assets/svg/xmark.svg';
import { navLinks } from '../../data/nav-links';
---

<div class="drawer-container" id="drawer-container">
	<button
		class="menu-button"
		id="drawer-toggle"
		aria-expanded="false"
		aria-controls="mobile-drawer"
		aria-label="Open menu"
	>
		<BarsIcon width={24} height={24} aria-hidden="true" />
	</button>
	<div class="overlay" id="drawer-overlay" aria-hidden="true"></div>
	<div
		id="mobile-drawer"
		class="drawer"
		role="dialog"
		aria-modal="true"
		aria-label="Mobile navigation"
	>
		<div>
			<button class="icon-button" id="drawer-close" aria-label="Close menu">
				<CloseIcon width={24} height={24} aria-hidden="true" /></button
			>
		</div>
		<nav aria-label="Mobile menu">
			{navLinks.map((link) => <a href={`/${link.path}`}>{link.label}</a>)}
		</nav>
	</div>
</div>

<script>
	const container = document.getElementById('drawer-container');
	const toggle = document.getElementById('drawer-toggle');
	const closeButton = document.getElementById('drawer-close');
	const overlay = document.getElementById('drawer-overlay');

	const setOpen = (open: boolean) => {
		container?.classList.toggle('open', open);
		document.body.classList.toggle('lock-scroll', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => {
		setOpen(!container?.classList.contains('open'));
	});
	overlay?.addEventListener('click', () => setOpen(false));
	closeButton?.addEventListener('click', () => setOpen(false));
	container?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});
</script>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	.drawer-container {
		display: none;
	}

	.menu-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 6px;
		border-radius: 999px;
		color: #ffffff;
		background: var(--button-gradient);
		border: 1px solid rgba(0, 0, 0, 0.1);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
		transition: $quick-transition;
		cursor: pointer;

		&:hover {
			filter: brightness(1.08);
		}

		& svg {
			color: #ffffff;
		}
	}

	.overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background-color: rgba(0, 0, 0, 0.6);
		z-index: 2;
		opacity: 0;
		pointer-events: none;
		transition: $transition;

		.drawer-container.open & {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.drawer {
		right: 0;
		top: 0;
		background-color: var(--background);
		position: absolute;
		width: 75vw;
		height: 100vh;
		z-index: 3;
		transform: translateX(75vw);
		transition: $transition;
		box-shadow: -4px 0 16px rgba(0, 0, 0, 0.18);

		.drawer-container.open & {
			transform: translateX(0);
		}

		& div {
			padding: 18px 16px 14px;
			border-bottom: var(--border);
			background: var(--header-gradient);

			& svg {
				color: #ffffff;
			}
		}
	}

	nav {
		text-align: left;
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 1.2rem;

		& a {
			text-decoration: none;
			padding: 10px 14px;
			border-radius: 999px;
			background: rgba(0, 174, 239, 0.08);
			border: 1px solid rgba(0, 174, 239, 0.15);
			transition: $quick-transition;

			&:hover {
				background: rgba(0, 174, 239, 0.18);
			}
		}
	}

	@media screen and (max-width: $max-mobile-width) {
		.drawer-container {
			display: block;
		}
	}
</style>
