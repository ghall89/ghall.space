---
import BarsIcon from '../../assets/svg/bars.svg';
import CloseIcon from '../../assets/svg/xmark.svg';
import { navLinks } from '../../data/nav-links';
---

<div class="drawer-container" id="drawer-container">
	<button
		class="menu-button"
		id="drawer-toggle"
		aria-expanded="false"
		aria-controls="mobile-drawer"
		aria-label="Open menu"
	>
		<BarsIcon width={24} height={24} aria-hidden="true" />
	</button>
	<div class="overlay" id="drawer-overlay" aria-hidden="true"></div>
	<div
		id="mobile-drawer"
		class="drawer"
		role="dialog"
		aria-modal="true"
		aria-label="Mobile navigation"
	>
		<div>
			<button class="icon-button" id="drawer-close" aria-label="Close menu">
				<CloseIcon width={24} height={24} aria-hidden="true" /></button
			>
		</div>
		<nav aria-label="Mobile menu">
			{navLinks.map((link) => <a href={`/${link.path}`}>{link.label}</a>)}
		</nav>
	</div>
</div>

<script>
	const container = document.getElementById('drawer-container');
	const toggle = document.getElementById('drawer-toggle');
	const closeButton = document.getElementById('drawer-close');
	const overlay = document.getElementById('drawer-overlay');

	const setOpen = (open: boolean) => {
		container?.classList.toggle('open', open);
		document.body.classList.toggle('lock-scroll', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => {
		setOpen(!container?.classList.contains('open'));
	});
	overlay?.addEventListener('click', () => setOpen(false));
	closeButton?.addEventListener('click', () => setOpen(false));
	container?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});
</script>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	.drawer-container {
		display: none;
	}

	.menu-button {
		display: inline-flex;
		padding: 4px;
		color: var(--text);
		background: none;
		border: var(--border);
		cursor: pointer;

		& svg {
			color: var(--text);
		}
	}

	.overlay {
		position: fixed;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.5);
		z-index: 2;
		opacity: 0;
		pointer-events: none;

		.drawer-container.open & {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.drawer {
		position: fixed;
		top: 0;
		right: 0;
		width: 75vw;
		height: 100vh;
		background-color: var(--background);
		border-left: var(--border);
		z-index: 3;
		transform: translateX(100%);
		visibility: hidden;

		.drawer-container.open & {
			transform: translateX(0);
			visibility: visible;
		}

		& div {
			padding: 1rem;
			border-bottom: var(--border);
		}
	}

	nav {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1rem;
		font-size: 1.2rem;
	}

	@media screen and (max-width: $max-mobile-width) {
		.drawer-container {
			display: block;
		}
	}
</style>
