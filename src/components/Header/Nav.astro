---
import { navLinks } from '../../data/nav-links';
---

<nav aria-label="Main">
	<ul>
		{
			navLinks.map((link) => (
				<li>
					<a href={`/${link.path}`}>{link.label}</a>
				</li>
			))
		}
	</ul>
</nav>

<style lang="scss">
	ul {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
		gap: 1rem;
		margin: 0;
		padding: 0;
	}

	@media screen and (max-width: 768px) {
		nav {
			display: none;
		}
	}
</style>
