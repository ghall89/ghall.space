---
import type { CollectionEntry } from 'astro:content';
import type { Page } from 'astro';

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
---

<div class="pagination">
	{
		page.currentPage !== 1 ? (
			<a class="prev" href={`/blog/page/${page.currentPage - 1}`}>
				Previous
			</a>
		) : (
			<span class="prev disabled">Previous</span>
		)
	}

	<div class="page-numbers">
		{
			Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) =>
				page.currentPage === n ? (
					<span class="page-number current" aria-current="page">
						{n}
					</span>
				) : (
					<a class="page-number" href={`/blog/page/${n}`}>
						{n}
					</a>
				)
			)
		}
	</div>

	{
		page.currentPage !== page.lastPage ? (
			<a class="next" href={`/blog/page/${page.currentPage + 1}`}>
				Next
			</a>
		) : (
			<span class="next disabled">Next</span>
		)
	}
</div>

<style lang="scss">
	@use '../../styles/variables.scss' as *;

	.pagination {
		display: flex;
		justify-content: center;
		margin: auto;
		margin-top: 2rem;
		gap: 0;

		& a,
		& span {
			display: inline-block;
			padding: 5px 14px;
			border-radius: 999px;
			font-size: 0.85rem;
			font-weight: 700;
			text-decoration: none;
		}

		& a {
			color: #ffffff;
			background: var(--button-gradient);
			border: 1px solid rgba(0, 0, 0, 0.1);
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
			transition: $quick-transition;

			&:hover {
				filter: brightness(1.08);
			}
		}

		& .prev {
			border-radius: 999px 0 0 999px;
		}

		& .next {
			border-radius: 0 999px 999px 0;
		}

		& .page-numbers {
			display: flex;
			gap: 0;
			align-items: center;
		}

		& .page-number {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 1.6rem;
			padding: 5px 8px;
			border-radius: 0;
			font-size: 0.85rem;
			font-weight: 700;
			text-decoration: none;
			color: var(--text);
			background: rgba(0, 0, 0, 0.06);
			border: 1px solid rgba(0, 0, 0, 0.08);
			transition: $quick-transition;

			&:hover {
				background: rgba(0, 0, 0, 0.1);
				filter: none;
			}

			&.current {
				color: #ffffff;
				background: var(--button-gradient);
				border-color: rgba(0, 0, 0, 0.1);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
			}
		}
	}

	.disabled {
		color: var(--text);
		background: rgba(0, 0, 0, 0.06);
		border: 1px solid rgba(0, 0, 0, 0.08);
		opacity: 0.7;
	}
</style>
