---
import { add, format } from 'date-fns';

interface Props {
	title: string;
	date?: Date;
	slug?: string;
}

const { title, date, slug } = Astro.props;
---

<div class="blog-header">
	{slug ? <a href={`/blog/${slug}`}>{title}</a> : <h1>{title}</h1>}
	{
		date && (
			<time datetime={new Date(date).toDateString()}>
				{format(add(new Date(date), { hours: 6 }), 'MMM do, y')}
			</time>
		)
	}
</div>

<style lang="scss">
	a {
		font-size: 1.5rem;
	}

	.blog-header {
		margin-bottom: 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;

		& h1 {
			margin: 0 0 0.5rem;
		}
	}
</style>
