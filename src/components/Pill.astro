---
interface Props {
	href?: string;
}

const { href } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class="pill" href={href}>
	<slot />
</Element>

<style lang="scss">
	.pill {
		display: inline-block;
		padding: 0 0.5rem;
		font-size: 0.8rem;
		border: var(--border);
	}
</style>
